# ==============================================================================
# FICHIERS ET DOSSIERS À IGNORER DANS LE PROJET SCORING MICROFINANCE UIYA
# ==============================================================================

# Dépendances Node.js (Frontend & Mobile)
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Builds Frontend
frontend-web/dist/
frontend-web/dist-ssr/
frontend-web/.env.local
frontend-web/.env.*.local

# Dépendances et caches Laravel
backend-laravel/vendor/
backend-laravel/.env
backend-laravel/storage/*.key
backend-laravel/storage/oauth-*.key
backend-laravel/storage/logs/*.log
backend-laravel/storage/framework/cache/data/*
backend-laravel/storage/framework/sessions/*
backend-laravel/storage/framework/views/*
!backend-laravel/storage/framework/cache/data/.gitignore
!backend-laravel/storage/framework/sessions/.gitignore
!backend-laravel/storage/framework/views/.gitignore
!backend-laravel/storage/logs/.gitignore

# Environnements virtuels et caches Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/

# Checkpoints Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Environnement et secrets
.env
.env.backup
.env.production

# IDEs, Éditeurs et Système d'exploitation
.vscode/
.idea/
